# ── Database (Neon Postgres with pgvector) ────────────────────────────────────
# Pooled connection string (used by Prisma at runtime)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Direct (non-pooled) connection string (used by Prisma Migrate)
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Used for chat (gpt-4o-mini), quiz generation, syllabus parsing, and embeddings
OPENAI_API_KEY="sk-..."

# ── NextAuth v5 ───────────────────────────────────────────────────────────────
# Google OAuth credentials (console.cloud.google.com → Credentials)
GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# Random secret for signing JWTs — generate with: openssl rand -base64 32
AUTH_SECRET="..."

# Optional — Vercel auto-sets this in production
# NEXTAUTH_URL="http://localhost:3000"
